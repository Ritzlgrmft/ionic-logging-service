{
  "name": "ionic-logging",
  "version": "22.0.0",
  "description": "Components for Ionic logging",
  "author": {
    "name": "Markus Wagner",
    "email": "markus.wagner02@web.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ritzlgrmft/ionic-logging-service.git"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "keywords": [
    "ionic",
    "angular",
    "mobile",
    "logging",
    "log4javascript"
  ],
  "scripts": {
    "build": "npm run build-service && npm run build-viewer && npm run build-viewer-app",
    "build-service": "ng build ionic-logging-service --configuration production",
    "build-viewer": "ng build ionic-logging-viewer --configuration production",
    "build-viewer-app": "ng build ionic-logging-viewer-app --configuration production",
    "test": "npm run test-service && npm run test-viewer && ng lint && npm run e2e",
    "test-service": "npm run test-coverage-service && npm run test-compodoc-service",
    "test-viewer": "npm run test-coverage-viewer && npm run test-compodoc-viewer",
    "test-coverage-service": "ng test ionic-logging-service --watch false --coverage",
    "test-coverage-viewer": "ng test ionic-logging-viewer --watch false --coverage",
    "test-compodoc-service": "cd projects/ionic-logging-service && compodoc --coverageTest 100 && cd ../..",
    "test-compodoc-viewer": "cd projects/ionic-logging-viewer && compodoc --coverageTest 100 && cd ../..",
    "test-watch-service": "ng test ionic-logging-service --coverage",
    "test-watch-viewer": "ng test ionic-logging-viewer --coverage",
    "lint": "ng lint",
    "e2e": "npm run cypress:run",
    "compodoc": "npm run compodoc-service && npm run compodoc-viewer",
    "compodoc-service": "cd projects/ionic-logging-service && compodoc && cd ../..",
    "compodoc-viewer": "cd projects/ionic-logging-viewer && compodoc && cd ../..",
    "cypress:open": "ng run ionic-logging-viewer-app:cypress-open",
    "cypress:run": "ng run ionic-logging-viewer-app:cypress-run",
    "serve-viewer-app": "ionic serve --project ionic-logging-viewer-app"
  },
  "dependencies": {
    "@angular/common": ">=22.0.0",
    "@angular/compiler": ">=22.0.0",
    "@angular/core": ">=22.0.0",
    "@angular/forms": ">=22.0.0",
    "@angular/platform-browser": ">=22.0.0",
    "@angular/router": ">=22.0.0",
    "@ionic/angular": ">=8.0.0",
    "ionicons": ">=8.0.0",
    "log4javascript": "^1.4.16",
    "rxjs": "^7.5.0",
    "tslib": "^2.3.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.2",
    "@angular-devkit/schematics": "^22.1.2",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@compodoc/compodoc": "2.0.0",
    "@cypress/schematic": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@ionic/angular": "^8.8.16",
    "@mswjs/interceptors": "^0.42.3",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "cypress": "15.19.0",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "fsevents": "2.3.3",
    "ionicons": "8.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "30.0.1",
    "ng-packagr": "^22.1.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}